<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Translucent Frosted Glass Background (allowing desktop blur to shine through) -->
    <LinearGradientBrush x:Key="MidnightCanvasBgBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#420D0F1B" Offset="0.0"/>
        <GradientStop Color="#30090B15" Offset="0.5"/>
        <GradientStop Color="#44070810" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Specular Frosted Glass Border Rim -->
    <LinearGradientBrush x:Key="FrostedGlassRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#90FFFFFF" Offset="0.0"/>
        <GradientStop Color="#35FFFFFF" Offset="0.3"/>
        <GradientStop Color="#18FFFFFF" Offset="0.75"/>
        <GradientStop Color="#45FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ==================== VIBRANT NEON AURA GRADIENTS ==================== -->

    <!-- ==================== CASCADING GREEN AURA GRADIENTS ==================== -->

    <!-- Level 0: Top Element (100% Full Vibrant Electric Neon Lime - exactly as requested) -->
    <RadialGradientBrush x:Key="CardAura_Green0" Center="0.5,0.4" GradientOrigin="0.5,0.3" RadiusX="0.95" RadiusY="0.95">
        <GradientStop Color="#550A2012" Offset="0.0"/>
        <GradientStop Color="#700F3A20" Offset="0.4"/>
        <GradientStop Color="#A500C853" Offset="0.72"/>
        <GradientStop Color="#D000E676" Offset="0.90"/>
        <GradientStop Color="#F076FF03" Offset="1.0"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="CardGlassRim_Green0" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A0B9F6CA" Offset="0.0"/>
        <GradientStop Color="#30FFFFFF" Offset="0.5"/>
        <GradientStop Color="#8000E676" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Level 1: 2nd Element (Noticeably softer emerald glow ~65% green) -->
    <RadialGradientBrush x:Key="CardAura_Green1" Center="0.5,0.42" GradientOrigin="0.5,0.3" RadiusX="0.95" RadiusY="0.95">
        <GradientStop Color="#45081C10" Offset="0.0"/>
        <GradientStop Color="#580D2C18" Offset="0.4"/>
        <GradientStop Color="#78009E40" Offset="0.72"/>
        <GradientStop Color="#9500B248" Offset="0.90"/>
        <GradientStop Color="#B000C853" Offset="1.0"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="CardGlassRim_Green1" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#75B9F6CA" Offset="0.0"/>
        <GradientStop Color="#25FFFFFF" Offset="0.5"/>
        <GradientStop Color="#5500C853" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Level 2: 3rd Element (Deep forest mint ~40% green) -->
    <RadialGradientBrush x:Key="CardAura_Green2" Center="0.5,0.45" GradientOrigin="0.5,0.3" RadiusX="0.95" RadiusY="0.95">
        <GradientStop Color="#3506160C" Offset="0.0"/>
        <GradientStop Color="#42092112" Offset="0.45"/>
        <GradientStop Color="#52006A2B" Offset="0.78"/>
        <GradientStop Color="#68008034" Offset="1.0"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="CardGlassRim_Green2" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#50B9F6CA" Offset="0.0"/>
        <GradientStop Color="#20FFFFFF" Offset="0.5"/>
        <GradientStop Color="#35008034" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Level 3: 4th Element (Subtle mint undertone ~20% green) -->
    <RadialGradientBrush x:Key="CardAura_Green3" Center="0.5,0.45" GradientOrigin="0.5,0.3" RadiusX="0.95" RadiusY="0.95">
        <GradientStop Color="#25040F08" Offset="0.0"/>
        <GradientStop Color="#2C07170D" Offset="0.5"/>
        <GradientStop Color="#3500481D" Offset="1.0"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="CardGlassRim_Green3" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#30B9F6CA" Offset="0.0"/>
        <GradientStop Color="#18FFFFFF" Offset="0.5"/>
        <GradientStop Color="#20005C25" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Level 4: 5th+ Elements (Deep midnight dark glass with faint frosted rim ~10% green) -->
    <RadialGradientBrush x:Key="CardAura_Green4" Center="0.5,0.45" GradientOrigin="0.5,0.3" RadiusX="0.95" RadiusY="0.95">
        <GradientStop Color="#1C030A05" Offset="0.0"/>
        <GradientStop Color="#20040D07" Offset="1.0"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="CardGlassRim_Green4" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#22FFFFFF" Offset="0.0"/>
        <GradientStop Color="#12FFFFFF" Offset="0.5"/>
        <GradientStop Color="#15004018" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Aliases for compatibility -->
    <RadialGradientBrush x:Key="CardAura_Lime" Center="0.5,0.4" GradientOrigin="0.5,0.3" RadiusX="0.95" RadiusY="0.95">
        <GradientStop Color="#550A2012" Offset="0.0"/>
        <GradientStop Color="#700F3A20" Offset="0.4"/>
        <GradientStop Color="#A500C853" Offset="0.72"/>
        <GradientStop Color="#D000E676" Offset="0.90"/>
        <GradientStop Color="#F076FF03" Offset="1.0"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="CardGlassRim_Lime" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A0B9F6CA" Offset="0.0"/>
        <GradientStop Color="#30FFFFFF" Offset="0.5"/>
        <GradientStop Color="#8000E676" Offset="1.0"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="CardAura_Orange" Center="0.5,0.4" GradientOrigin="0.5,0.3" RadiusX="0.95" RadiusY="0.95">
        <GradientStop Color="#45081C10" Offset="0.0"/>
        <GradientStop Color="#9500B248" Offset="0.90"/>
        <GradientStop Color="#B000C853" Offset="1.0"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="CardGlassRim_Orange" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#75B9F6CA" Offset="0.0"/>
        <GradientStop Color="#5500C853" Offset="1.0"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="CardAura_Cyan" Center="0.5,0.45" GradientOrigin="0.5,0.3" RadiusX="0.95" RadiusY="0.95">
        <GradientStop Color="#3506160C" Offset="0.0"/>
        <GradientStop Color="#68008034" Offset="1.0"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="CardGlassRim_Cyan" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#50B9F6CA" Offset="0.0"/>
        <GradientStop Color="#35008034" Offset="1.0"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="CardAura_Magenta" Center="0.5,0.45" GradientOrigin="0.5,0.3" RadiusX="0.95" RadiusY="0.95">
        <GradientStop Color="#25040F08" Offset="0.0"/>
        <GradientStop Color="#3500481D" Offset="1.0"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="CardGlassRim_Magenta" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#30B9F6CA" Offset="0.0"/>
        <GradientStop Color="#20005C25" Offset="1.0"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="CardAura_Coral" Center="0.5,0.42" GradientOrigin="0.5,0.3" RadiusX="0.95" RadiusY="0.95">
        <GradientStop Color="#45081C10" Offset="0.0"/>
        <GradientStop Color="#B000C853" Offset="1.0"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="CardGlassRim_Coral" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#75B9F6CA" Offset="0.0"/>
        <GradientStop Color="#5500C853" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Base Palette & Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#E8EAEE"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A5A8BC"/>
    <SolidColorBrush x:Key="NeonLimeBrush" Color="#00E676"/>
    <SolidColorBrush x:Key="NeonOrangeBrush" Color="#FF6D00"/>
    <SolidColorBrush x:Key="NeonCyanBrush" Color="#00E5FF"/>
    <SolidColorBrush x:Key="NeonMagentaBrush" Color="#FF007F"/>
    <SolidColorBrush x:Key="PastelPinkBrush" Color="#FF3399"/>

